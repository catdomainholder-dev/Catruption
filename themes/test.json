{
    "name": "test",
    "images": {
        "corners": {
            "path": "squares.webp",
            "type": "atlas",
            "grid": {
                "columns": 4,
                "rows": 4
            },
            "cornerSize": "2x2",
            "extensions": [".webp", ".png"]
        },
        "edges": {
            "path": "triangles.webp",
            "type": "atlas",
            "grid": {
                "columns": 2,
                "rows": 2
            },
            "edgeType": "diagonal",
            "extensions": [".webp", ".png"]
        }
    },
    "inset": 20,
    "topInsetMultiplier": 2,
    "contentOffset": {
        "x": 0,
        "y": 0
    },
    "titleBar": {
        "fontSize": "20px",
        "fontWeight": "bold",
        "textShadow": "0 0 20px rgba(0,0,0,0.9), 0 0 40px rgba(0,0,0,0.7)",
        "color": "black",
        "position": "top-center",
        "offsetX": 0,
        "offsetY": 0
    },
    "content": {
        "fontSize": "24px",
        "fontWeight": "bold",
        "background": "rgba(0, 0, 0, 0.3)",
        "border": "2px solid rgba(255, 255, 255, 0.3)",
        "borderRadius": "8px",
        "padding": "12px 24px",
        "color": "white",
        "textShadow": "0 0 20px rgba(0,0,0,0.9), 0 0 40px rgba(0,0,0,0.7)"
    },
    "window": {
        "background": "transparent",
        "border": "none",
        "color": "white",
        "boxShadow": "none"
    },
    "blend": {
        "alpha": 1
    },
    "icon": {
        "enabled": true,
        "position": "bottom-left",
        "offsetX": 450,
        "offsetY": -480,
        "size": 110,
        "zIndex": 100,
        "hideWhenMinimized": false
    },
    "controls": {
        "position": "top-center",
        "offsetX": 0,
        "offsetY": 420,
        "size": 80,
        "overlap": 5,
        "enabled": true
    }
}